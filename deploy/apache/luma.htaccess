# Optional Apache rules for Luma CMS on shared hosting.
# Place in apps/api/public/.htaccess or include from vhost.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Legacy Studio path → canonical admin UI
    RewriteRule ^studio/?(.*)$ admin/$1 [R=301,L]

    # Luma Studio static (when dist is deployed under apps/studio/dist)
    RewriteRule ^admin/(.*)$ ../studio/dist/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
