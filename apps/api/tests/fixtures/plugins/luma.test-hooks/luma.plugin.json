{
  "schemaVersion": "1.0",
  "id": "luma.test-hooks",
  "name": "Test Hooks Plugin",
  "description": "Test fixture for content lifecycle hooks.",
  "version": "0.1.0",
  "type": "plugin",
  "author": {
    "name": "Luma CMS Tests"
  },
  "compatibility": {
    "luma": "^0.1.0",
    "pluginApi": "^1.0",
    "php": "^8.3"
  },
  "capabilities": [
    "content.publish"
  ],
  "extensionPoints": [
    "content.afterPublish"
  ],
  "entrypoints": {
    "backend": "src/Plugin.php"
  },
  "migrations": {
    "path": "database/migrations"
  }
}
